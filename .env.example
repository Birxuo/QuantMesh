# ============================
# QuantMesh Environment Config
# ============================

# --- Wallet Private Keys (EOA) ---
# Generate these with: python scripts/seed_wallets.py
PROVIDER_PRIVATE_KEY=0x_your_provider_private_key_here
CONSUMER_PRIVATE_KEY=0x_your_consumer_private_key_here

# --- Derived Addresses (auto-populated by seed_wallets.py) ---
PROVIDER_ADDRESS=0x_your_provider_address_here
CONSUMER_ADDRESS=0x_your_consumer_address_here

# --- Network ---
# Base Sepolia (testnet) — supported by x402.org facilitator
NETWORK_ID=eip155:84532
CHAIN_ID=84532
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# --- x402 Facilitator ---
FACILITATOR_URL=https://x402.org/facilitator

# --- App Config ---
PROVIDER_HOST=0.0.0.0
PROVIDER_PORT=8000
DASHBOARD_PORT=5173
PROVIDER_URL=http://localhost:8000
